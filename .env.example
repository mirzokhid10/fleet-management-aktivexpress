# Copy to .env for local development: cp .env.example .env
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
REDIS_URL=redis://redis:6379/0

# Telegram bot (Day 6). Token from @BotFather — never commit it.
TELEGRAM_BOT_TOKEN=
BOT_MODE=polling
# Server only (webhook mode):
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
