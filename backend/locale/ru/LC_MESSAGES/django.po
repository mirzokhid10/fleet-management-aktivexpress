#: apps/accounts/forms.py:9 apps/accounts/templates/accounts/login.html:63
msgid "Keep me logged in"
msgstr "Запомнить меня"

#: apps/accounts/forms.py:13
msgid "Drivers use the Telegram bot, not the web app."
msgstr "Водители работают через Telegram-бот, а не через веб-приложение."

#: apps/accounts/forms.py:14
msgid "Sign in with Telegram. Passwords are only for administrators."
msgstr "Войдите через Telegram. Пароль — только для администраторов."

#: apps/accounts/models.py:16
msgid "Director"
msgstr "Директор"

#: apps/accounts/models.py:17
msgid "Dispatcher"
msgstr "Диспетчер"

#: apps/accounts/models.py:18
msgid "Storekeeper"
msgstr "Кладовщик"

#: apps/accounts/models.py:19 apps/bot/templates/bot/request_list.html:27
#: apps/fleet/templates/fleet/shift_list.html:46
msgid "Driver"
msgstr "Водитель"

#: apps/accounts/templates/accounts/login.html:4
#: apps/accounts/templates/accounts/login.html:8
#: apps/accounts/templates/accounts/login.html:67
msgid "Sign in"
msgstr "Вход"

#: apps/accounts/templates/accounts/login.html:9
msgid "Confirm the sign-in in the company Telegram bot."
msgstr "Подтвердите вход в Telegram-боте компании."

#: apps/accounts/templates/accounts/login.html:17
#: apps/accounts/templates/accounts/telegram_wait.html:4
#: apps/accounts/templates/accounts/telegram_wait.html:8
msgid "Sign in with Telegram"
msgstr "Войти через Telegram"

#: apps/accounts/templates/accounts/login.html:20
msgid "Drivers: use the company Telegram bot."
msgstr "Водители: пользуйтесь Telegram-ботом компании."

#: apps/accounts/templates/accounts/login.html:24
msgid "Administrator sign-in with password"
msgstr "Вход администратора по паролю"

#: apps/accounts/templates/accounts/login.html:39
msgid "Username"
msgstr "Логин"

#: apps/accounts/templates/accounts/login.html:47
msgid "Password"
msgstr "Пароль"

#: apps/accounts/templates/accounts/login.html:52
msgid "Hide password"
msgstr "Скрыть пароль"

#: apps/accounts/templates/accounts/login.html:52
msgid "Show password"
msgstr "Показать пароль"

#: apps/accounts/templates/accounts/telegram_wait.html:12
msgid "Open the bot: tap the button, or scan the code with your phone."
msgstr "Откройте бота: нажмите кнопку или отсканируйте код телефоном."

#: apps/accounts/templates/accounts/telegram_wait.html:13
msgid "In the bot, tap this number:"
msgstr "В боте нажмите это число:"

#: apps/accounts/templates/accounts/telegram_wait.html:20
msgid "Open Telegram"
msgstr "Открыть Telegram"

#: apps/accounts/templates/accounts/telegram_wait.html:25
msgid "Waiting for confirmation…"
msgstr "Ждём подтверждения…"

#: apps/accounts/templates/accounts/telegram_wait.html:31
msgid "The sign-in was cancelled in the bot."
msgstr "Вход отменён в боте."

#: apps/accounts/templates/accounts/telegram_wait.html:32
msgid "Time is up. Start again."
msgstr "Время вышло. Начните заново."

#: apps/accounts/templates/accounts/telegram_wait.html:36
msgid "Try again"
msgstr "Попробовать снова"

#: apps/accounts/templates/accounts/telegram_wait.html:40
msgid "Back"
msgstr "Назад"

#: apps/bot/handlers.py:31
#, python-format
msgid "Hello, %(name)s! This is the Aktiv Fleet bot."
msgstr "Здравствуйте, %(name)s! Это бот Aktiv Fleet."

#: apps/bot/handlers.py:33
msgid ""
"Here you will start and end shifts, share your location and send vehicle "
"data."
msgstr "Здесь вы будете начинать и заканчивать смену, делиться геопозицией и отправлять данные по машине."

#: apps/bot/handlers.py:34
msgid "Commands: /help"
msgstr "Команды: /help"

#: apps/bot/handlers.py:40
msgid "What the bot can do:"
msgstr "Что умеет бот:"

#: apps/bot/handlers.py:41 apps/bot/setup.py:33
msgid "start"
msgstr "начать"

#: apps/bot/handlers.py:42 apps/bot/setup.py:34
msgid "start a shift"
msgstr "начать смену"

#: apps/bot/handlers.py:43 apps/bot/setup.py:35
msgid "end the shift"
msgstr "закончить смену"

#: apps/bot/handlers.py:44 apps/bot/setup.py:36
msgid "change the language"
msgstr "сменить язык"

#: apps/bot/handlers.py:45 apps/bot/setup.py:37
msgid "this help"
msgstr "эта справка"

#: apps/bot/handlers.py:50
msgid ""
"To start, send your phone number with the button below. It must be the "
"number the company has for you."
msgstr "Для начала отправьте свой номер телефона кнопкой ниже. Это должен быть номер, который есть у компании."

#: apps/bot/handlers.py:64 apps/bot/handlers.py:127
msgid ""
"Your registration is waiting for a manager to confirm it. I will write to "
"you here."
msgstr "Ваша регистрация ждёт подтверждения руководителя. Я напишу вам здесь."

#: apps/bot/handlers.py:96
#, python-format
msgid "Language: %(language)s"
msgstr "Язык: %(language)s"

#: apps/bot/handlers.py:113
msgid "Please send your own number with the button."
msgstr "Пожалуйста, отправьте свой номер кнопкой."

#: apps/bot/handlers.py:119
msgid "Only Uzbek phone numbers (+998) can be registered."
msgstr "Зарегистрироваться можно только с узбекским номером (+998)."

#: apps/bot/handlers.py:125
msgid "You are already registered."
msgstr "Вы уже зарегистрированы."

#: apps/bot/handlers.py:130
#, python-format
msgid ""
"The number %(phone)s is not in the company list. Ask the dispatcher to add "
"you, then send it again with /start."
msgstr "Номера %(phone)s нет в списке компании. Попросите диспетчера добавить вас, затем отправьте его снова через /start."

#: apps/bot/handlers.py:134
msgid ""
"Thank you! A manager will confirm your registration soon. I will write to "
"you here."
msgstr "Спасибо! Руководитель скоро подтвердит регистрацию. Я напишу вам здесь."

#: apps/bot/handlers.py:146
msgid "This sign-in link has expired. Start again on the website."
msgstr "Срок этой ссылки для входа истёк. Начните заново на сайте."

#: apps/bot/handlers.py:147 apps/bot/location_handlers.py:63
#: apps/bot/shift_handlers.py:90
msgid ""
"You are not registered yet. Send /start and share your phone number first."
msgstr "Вы ещё не зарегистрированы. Сначала отправьте /start и поделитесь номером телефона."

#: apps/bot/handlers.py:149
msgid "Your account cannot use the web app. Drivers work in this bot only."
msgstr "Ваш аккаунт не может пользоваться веб-приложением. Водители работают только в этом боте."

#: apps/bot/handlers.py:150
msgid "Wrong number. The sign-in was cancelled. Start again on the website."
msgstr "Неверное число. Вход отменён. Начните заново на сайте."

#: apps/bot/handlers.py:152
msgid ""
"The sign-in was cancelled. If you did not try to sign in, tell the director."
msgstr "Вход отменён. Если это были не вы, сообщите директору."

#: apps/bot/handlers.py:164
msgid "Sign in to the Aktiv Fleet web app?"
msgstr "Войти в веб-приложение Aktiv Fleet?"

#: apps/bot/handlers.py:166
#, python-format
msgid "Browser: %(browser)s"
msgstr "Браузер: %(browser)s"

#: apps/bot/handlers.py:167
msgid "Tap the number shown on your screen."
msgstr "Нажмите число, которое видите на экране."

#: apps/bot/handlers.py:180
msgid "You are signed in. You can go back to the browser."
msgstr "Вы вошли. Можно вернуться в браузер."

#: apps/bot/handlers.py:188
msgid "I don't understand this yet. Send /help to see what I can do."
msgstr "Пока не понимаю. Отправьте /help, чтобы увидеть, что я умею."

#: apps/bot/keyboards.py:22
msgid "Send my phone number"
msgstr "Отправить мой номер"

#: apps/bot/keyboards.py:30
msgid "It wasn't me"
msgstr "Это не я"

#: apps/bot/keyboards.py:53
msgid "Yes, end the shift"
msgstr "Да, закончить смену"

#: apps/bot/keyboards.py:55
msgid "No, keep working"
msgstr "Нет, продолжаю работать"

#: apps/bot/location_handlers.py:23
msgid ""
"Share your live location: tap 📎, choose Location, then “Share My Live "
"Location” and “Until I turn it off”."
msgstr "Включите трансляцию геопозиции: нажмите 📎, выберите «Геопозиция», затем «Транслировать геопозицию» и «Пока не выключу»."

#: apps/bot/location_handlers.py:48
msgid "Your location is on. Keep sharing it until /end_shift."
msgstr "Геопозиция включена. Не выключайте её до /end_shift."

#: apps/bot/location_handlers.py:51
msgid ""
"You stopped sharing your location. While you are on shift, please share it "
"again."
msgstr "Вы остановили трансляцию геопозиции. Пока вы на смене, включите её снова."

#: apps/bot/location_handlers.py:54
msgid "This is a one-time location. I need a live one."
msgstr "Это разовая геопозиция. Нужна трансляция."

#: apps/bot/location_handlers.py:57
msgid "Start a shift first with /start_shift, then share your live location."
msgstr "Сначала начните смену через /start_shift, затем включите трансляцию геопозиции."

#: apps/bot/location_handlers.py:61 apps/bot/shift_handlers.py:95
#: apps/bot/shift_handlers.py:148
msgid "Shifts are for drivers only."
msgstr "Смены только для водителей."

#: apps/bot/models.py:47
msgid "Waiting"
msgstr "Ожидает"

#: apps/bot/models.py:48
msgid "Approved"
msgstr "Подтверждён"

#: apps/bot/models.py:49
msgid "Rejected"
msgstr "Отклонён"

#: apps/bot/models.py:52
msgid "Not our employee"
msgstr "Не наш сотрудник"

#: apps/bot/models.py:53
msgid "The number belongs to someone else"
msgstr "Номер принадлежит другому человеку"

#: apps/bot/models.py:54 apps/core/menu.py:72
msgid "Other"
msgstr "Прочее"

#: apps/bot/shift_handlers.py:47
#, python-format
msgid "%(hours)s h %(minutes)s min"
msgstr "%(hours)s ч %(minutes)s мин"

#: apps/bot/shift_handlers.py:48
#, python-format
msgid "%(minutes)s min"
msgstr "%(minutes)s мин"

#: apps/bot/shift_handlers.py:52
#, python-format
msgid ""
"You are already on shift with %(vehicle)s since %(time)s. Send /end_shift to "
"end it."
msgstr "Вы на смене на %(vehicle)s с %(time)s. Чтобы закончить, отправьте /end_shift."

#: apps/bot/shift_handlers.py:57
#, python-format
msgid ""
"%(vehicle)s is on shift with %(driver)s since %(time)s. If that is wrong, "
"call the dispatcher."
msgstr "%(vehicle)s на смене у %(driver)s с %(time)s. Если это ошибка, позвоните диспетчеру."

#: apps/bot/shift_handlers.py:65
#, python-format
msgid "Shift started: %(vehicle)s at %(time)s."
msgstr "Смена начата: %(vehicle)s в %(time)s."

#: apps/bot/shift_handlers.py:68
msgid "Send /end_shift when you finish."
msgstr "Когда закончите, отправьте /end_shift."

#: apps/bot/shift_handlers.py:73
#, python-format
msgid "Shift ended: %(vehicle)s, %(start)s–%(end)s (%(duration)s)."
msgstr "Смена закончена: %(vehicle)s, %(start)s–%(end)s (%(duration)s)."

#: apps/bot/shift_handlers.py:77
#, python-format
msgid "Distance: %(km)s km."
msgstr "Пробег: %(km)s км."

#: apps/bot/shift_handlers.py:78 apps/fleet/views.py:247
msgid "You can stop sharing your location now."
msgstr "Теперь можно выключить трансляцию геопозиции."

#: apps/bot/shift_handlers.py:105
#, python-format
msgid "No free vehicle matches “%(text)s”. Try again or call the dispatcher."
msgstr "Свободных машин по «%(text)s» не найдено. Попробуйте ещё раз или позвоните диспетчеру."

#: apps/bot/shift_handlers.py:108
msgid "There are no free vehicles. Call the dispatcher."
msgstr "Свободных машин нет. Позвоните диспетчеру."

#: apps/bot/shift_handlers.py:111
msgid "Which vehicle are you taking?"
msgstr "Какую машину вы берёте?"

#: apps/bot/shift_handlers.py:113
#, python-format
msgid "Showing %(shown)s of %(total)s."
msgstr "Показано %(shown)s из %(total)s."

#: apps/bot/shift_handlers.py:115
msgid "Not in the list? Type part of the plate number, for example 123."
msgstr "Нет в списке? Напишите часть госномера, например 123."

#: apps/bot/shift_handlers.py:160
msgid "This vehicle can no longer be chosen. Send /start_shift again."
msgstr "Эту машину больше нельзя выбрать. Отправьте /start_shift ещё раз."

#: apps/bot/shift_handlers.py:173
msgid "You have no open shift. Send /start_shift to start one."
msgstr "У вас нет открытой смены. Чтобы начать, отправьте /start_shift."

#: apps/bot/shift_handlers.py:176
#, python-format
msgid "End your shift with %(vehicle)s? Started at %(time)s, %(duration)s ago."
msgstr "Закончить смену на %(vehicle)s? Начата в %(time)s, %(duration)s назад."

#: apps/bot/shift_handlers.py:196 apps/fleet/views.py:236
msgid "This shift has already ended."
msgstr "Эта смена уже закончена."

#: apps/bot/shift_handlers.py:205
msgid "OK, the shift goes on."
msgstr "Хорошо, смена продолжается."

#: apps/bot/templates/bot/request_list.html:7
