msgstr "По этому запросу уже приняли решение."

#: apps/bot/views.py:55
#, python-format
msgid "✅ Your registration is confirmed. Welcome, %(name)s!"
msgstr "✅ Регистрация подтверждена. Добро пожаловать, %(name)s!"

#: apps/bot/views.py:57
#, python-format
msgid "%(name)s is registered."
msgstr "%(name)s зарегистрирован(а)."

#: apps/bot/views.py:59
