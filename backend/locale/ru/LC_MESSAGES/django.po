msgstr "Человек в нашем списке"

#: apps/bot/templates/bot/request_list.html:16
msgid "Telegram account"
msgstr "Аккаунт Telegram"

#: apps/bot/templates/bot/request_list.html:17
msgid "Phone"
msgstr "Телефон"

#: apps/bot/templates/bot/request_list.html:18
msgid "Sent"
msgstr "Отправлено"

#: apps/bot/templates/bot/request_list.html:36
msgid "Confirm"
msgstr "Подтвердить"

#: apps/bot/templates/bot/request_list.html:40
msgid "Reason"
msgstr "Причина"

#: apps/bot/templates/bot/request_list.html:44
msgid "Reject"
msgstr "Отклонить"

#: apps/bot/templates/bot/request_list.html:54
