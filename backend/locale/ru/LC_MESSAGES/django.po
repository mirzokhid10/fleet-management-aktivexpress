msgstr "Боту не удалось отправить сообщение."

#: apps/bot/views.py:73
msgid ""
"❌ Your registration was not confirmed. Ask the dispatcher if this is a "
"mistake."
msgstr "❌ Регистрация не подтверждена. Если это ошибка, обратитесь к диспетчеру."

#: apps/bot/views.py:74
msgid "The request was rejected."
msgstr "Запрос отклонён."

