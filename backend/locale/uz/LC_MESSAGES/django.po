#: apps/bot/handlers.py:31
#, python-format
msgid "Hello, %(name)s! This is the Aktiv Fleet bot."
msgstr "Assalomu alaykum, %(name)s! Bu Aktiv Fleet boti."

#: apps/bot/handlers.py:33
msgid ""
"Here you will start and end shifts, share your location and send vehicle "
"data."
msgstr "Bu yerda smenani boshlaysiz va tugatasiz, joylashuvingizni ulashasiz va mashina ma'lumotlarini yuborasiz."

#: apps/bot/handlers.py:34
msgid "Commands: /help"
msgstr "Buyruqlar: /help"

#: apps/bot/handlers.py:40
msgid "What the bot can do:"
msgstr "Bot nimalar qila oladi:"

#: apps/bot/handlers.py:41 apps/bot/setup.py:33
msgid "start"
msgstr "boshlash"

#: apps/bot/handlers.py:42 apps/bot/setup.py:34
msgid "start a shift"
msgstr "smenani boshlash"

#: apps/bot/handlers.py:43 apps/bot/setup.py:35
msgid "end the shift"
msgstr "smenani tugatish"

#: apps/bot/handlers.py:44 apps/bot/setup.py:36
msgid "change the language"
msgstr "tilni o'zgartirish"

#: apps/bot/handlers.py:45 apps/bot/setup.py:37
msgid "this help"
msgstr "ushbu yordam"

#: apps/bot/handlers.py:50
msgid ""
"To start, send your phone number with the button below. It must be the "
"number the company has for you."
msgstr "Boshlash uchun pastdagi tugma orqali telefon raqamingizni yuboring. Bu kompaniyadagi raqamingiz bo'lishi kerak."

#: apps/bot/handlers.py:64 apps/bot/handlers.py:127
msgid ""
"Your registration is waiting for a manager to confirm it. I will write to "
"you here."
msgstr "Ro'yxatdan o'tishingiz rahbar tasdig'ini kutmoqda. Shu yerda sizga yozaman."

#: apps/bot/handlers.py:96
#, python-format
msgid "Language: %(language)s"
msgstr "Til: %(language)s"

#: apps/bot/handlers.py:113
msgid "Please send your own number with the button."
msgstr "Iltimos, tugma orqali o'z raqamingizni yuboring."

#: apps/bot/handlers.py:119
msgid "Only Uzbek phone numbers (+998) can be registered."
msgstr "Faqat O'zbekiston raqamlari (+998) bilan ro'yxatdan o'tish mumkin."

#: apps/bot/handlers.py:125
msgid "You are already registered."
msgstr "Siz allaqachon ro'yxatdan o'tgansiz."

#: apps/bot/handlers.py:130
#, python-format
msgid ""
"The number %(phone)s is not in the company list. Ask the dispatcher to add "
"you, then send it again with /start."
msgstr "%(phone)s raqami kompaniya ro'yxatida yo'q. Dispetcherdan sizni qo'shishini so'rang, keyin /start orqali qayta yuboring."

#: apps/bot/handlers.py:134
msgid ""
"Thank you! A manager will confirm your registration soon. I will write to "
"you here."
msgstr "Rahmat! Rahbar tez orada ro'yxatdan o'tishingizni tasdiqlaydi. Shu yerda sizga yozaman."

#: apps/bot/handlers.py:146
msgid "This sign-in link has expired. Start again on the website."
msgstr "Bu kirish havolasining muddati tugagan. Saytda qaytadan boshlang."

#: apps/bot/handlers.py:147 apps/bot/shift_handlers.py:83
msgid ""
"You are not registered yet. Send /start and share your phone number first."
msgstr "Siz hali ro'yxatdan o'tmagansiz. Avval /start yuboring va telefon raqamingizni ulashing."

#: apps/bot/handlers.py:149
msgid "Your account cannot use the web app. Drivers work in this bot only."
msgstr "Hisobingiz veb-ilovadan foydalana olmaydi. Haydovchilar faqat shu botda ishlaydi."

#: apps/bot/handlers.py:150
msgid "Wrong number. The sign-in was cancelled. Start again on the website."
msgstr "Noto'g'ri raqam. Kirish bekor qilindi. Saytda qaytadan boshlang."

#: apps/bot/handlers.py:152
msgid ""
"The sign-in was cancelled. If you did not try to sign in, tell the director."
msgstr "Kirish bekor qilindi. Agar siz kirmoqchi bo'lmagan bo'lsangiz, direktorga xabar bering."

#: apps/bot/handlers.py:164
msgid "Sign in to the Aktiv Fleet web app?"
msgstr "Aktiv Fleet veb-ilovasiga kirasizmi?"

#: apps/bot/handlers.py:166
#, python-format
msgid "Browser: %(browser)s"
msgstr "Brauzer: %(browser)s"

#: apps/bot/handlers.py:167
msgid "Tap the number shown on your screen."
msgstr "Ekraningizda ko'rsatilgan raqamni bosing."

#: apps/bot/handlers.py:180
msgid "You are signed in. You can go back to the browser."
msgstr "Siz tizimga kirdingiz. Brauzerga qaytishingiz mumkin."

#: apps/bot/handlers.py:188
msgid "I don't understand this yet. Send /help to see what I can do."
msgstr "Buni hali tushunmayman. Nimalar qila olishimni ko'rish uchun /help yuboring."

#: apps/bot/keyboards.py:22
msgid "Send my phone number"
msgstr "Telefon raqamimni yuborish"

#: apps/bot/keyboards.py:30
msgid "It wasn't me"
msgstr "Bu men emasman"

#: apps/bot/keyboards.py:53
msgid "Yes, end the shift"
msgstr "Ha, smenani tugatish"

#: apps/bot/keyboards.py:55
msgid "No, keep working"
msgstr "Yo'q, ishni davom ettiraman"

#: apps/bot/models.py:47
msgid "Waiting"
msgstr "Kutilmoqda"

#: apps/bot/models.py:48
msgid "Approved"
msgstr "Tasdiqlangan"

#: apps/bot/models.py:49
msgid "Rejected"
msgstr "Rad etilgan"

#: apps/bot/models.py:52
msgid "Not our employee"
msgstr "Bizning xodim emas"

#: apps/bot/models.py:53
msgid "The number belongs to someone else"
msgstr "Raqam boshqa odamga tegishli"

#: apps/bot/models.py:54 apps/core/menu.py:72
msgid "Other"
msgstr "Boshqa"

#: apps/bot/shift_handlers.py:45
#, python-format
msgid "%(hours)s h %(minutes)s min"
msgstr "%(hours)s soat %(minutes)s daqiqa"

#: apps/bot/shift_handlers.py:46
#, python-format
msgid "%(minutes)s min"
msgstr "%(minutes)s daqiqa"

#: apps/bot/shift_handlers.py:50
#, python-format
msgid ""
"You are already on shift with %(vehicle)s since %(time)s. Send /end_shift to "
"end it."
msgstr "Siz %(time)s dan beri %(vehicle)s bilan smenadasiz. Tugatish uchun /end_shift yuboring."

#: apps/bot/shift_handlers.py:55
#, python-format
msgid ""
"%(vehicle)s is on shift with %(driver)s since %(time)s. If that is wrong, "
"call the dispatcher."
msgstr "%(vehicle)s %(time)s dan beri %(driver)s smenasida. Agar bu xato bo'lsa, dispetcherga qo'ng'iroq qiling."

#: apps/bot/shift_handlers.py:63
#, python-format
msgid "Shift started: %(vehicle)s at %(time)s."
msgstr "Smena boshlandi: %(vehicle)s, %(time)s."

#: apps/bot/shift_handlers.py:65
msgid "Send /end_shift when you finish."
msgstr "Ishni tugatganingizda /end_shift yuboring."

#: apps/bot/shift_handlers.py:70
#, python-format
msgid "Shift ended: %(vehicle)s, %(start)s–%(end)s (%(duration)s)."
msgstr "Smena tugadi: %(vehicle)s, %(start)s–%(end)s (%(duration)s)."

#: apps/bot/shift_handlers.py:88 apps/bot/shift_handlers.py:141
msgid "Shifts are for drivers only."
msgstr "Smenalar faqat haydovchilar uchun."

#: apps/bot/shift_handlers.py:98
#, python-format
msgid "No free vehicle matches “%(text)s”. Try again or call the dispatcher."
msgstr "“%(text)s” bo'yicha bo'sh avtomobil topilmadi. Qayta urinib ko'ring yoki dispetcherga qo'ng'iroq qiling."

#: apps/bot/shift_handlers.py:101
msgid "There are no free vehicles. Call the dispatcher."
msgstr "Bo'sh avtomobil yo'q. Dispetcherga qo'ng'iroq qiling."

#: apps/bot/shift_handlers.py:104
msgid "Which vehicle are you taking?"
msgstr "Qaysi avtomobilni olyapsiz?"

#: apps/bot/shift_handlers.py:106
#, python-format
msgid "Showing %(shown)s of %(total)s."
msgstr "%(total)s tadan %(shown)s tasi ko'rsatilgan."

#: apps/bot/shift_handlers.py:108
msgid "Not in the list? Type part of the plate number, for example 123."
msgstr "Ro'yxatda yo'qmi? Davlat raqamining bir qismini yozing, masalan 123."

#: apps/bot/shift_handlers.py:153
msgid "This vehicle can no longer be chosen. Send /start_shift again."
msgstr "Bu avtomobilni endi tanlab bo'lmaydi. /start_shift ni qayta yuboring."

#: apps/bot/shift_handlers.py:166
msgid "You have no open shift. Send /start_shift to start one."
msgstr "Sizda ochiq smena yo'q. Boshlash uchun /start_shift yuboring."

#: apps/bot/shift_handlers.py:169
#, python-format
msgid "End your shift with %(vehicle)s? Started at %(time)s, %(duration)s ago."
msgstr "%(vehicle)s bilan smenani tugatasizmi? %(time)s da boshlangan, %(duration)s oldin."

#: apps/bot/shift_handlers.py:189 apps/fleet/views.py:218
msgid "This shift has already ended."
msgstr "Bu smena allaqachon tugagan."

#: apps/bot/shift_handlers.py:197
msgid "OK, the shift goes on."
msgstr "Yaxshi, smena davom etmoqda."

