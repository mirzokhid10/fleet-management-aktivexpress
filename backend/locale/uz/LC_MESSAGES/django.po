#: apps/bot/handlers.py:27
#, python-format
msgid "Hello, %(name)s! This is the Aktiv Fleet bot."
msgstr "Assalomu alaykum, %(name)s! Bu Aktiv Fleet boti."

#: apps/bot/handlers.py:29
msgid ""
"Here you will start and end shifts, share your location and send vehicle "
"data."
msgstr "Bu yerda smenani boshlaysiz va tugatasiz, joylashuvingizni ulashasiz va mashina ma'lumotlarini yuborasiz."

#: apps/bot/handlers.py:30
msgid "Commands: /help"
msgstr "Buyruqlar: /help"

#: apps/bot/handlers.py:36
msgid "What the bot can do:"
msgstr "Bot nimalar qila oladi:"

#: apps/bot/handlers.py:37 apps/bot/setup.py:33
msgid "start"
msgstr "boshlash"

#: apps/bot/handlers.py:38 apps/bot/setup.py:34
msgid "change the language"
msgstr "tilni o'zgartirish"

#: apps/bot/handlers.py:39 apps/bot/setup.py:35
msgid "this help"
msgstr "ushbu yordam"

#: apps/bot/handlers.py:44
msgid ""
"To start, send your phone number with the button below. It must be the "
"number the company has for you."
msgstr "Boshlash uchun pastdagi tugma orqali telefon raqamingizni yuboring. Bu kompaniyadagi raqamingiz bo'lishi kerak."

#: apps/bot/handlers.py:58 apps/bot/handlers.py:121
msgid ""
"Your registration is waiting for a manager to confirm it. I will write to "
"you here."
msgstr "Ro'yxatdan o'tishingiz rahbar tasdig'ini kutmoqda. Shu yerda sizga yozaman."

#: apps/bot/handlers.py:90
#, python-format
msgid "Language: %(language)s"
msgstr "Til: %(language)s"

#: apps/bot/handlers.py:107
msgid "Please send your own number with the button."
msgstr "Iltimos, tugma orqali o'z raqamingizni yuboring."

#: apps/bot/handlers.py:113
msgid "Only Uzbek phone numbers (+998) can be registered."
msgstr "Faqat O'zbekiston raqamlari (+998) bilan ro'yxatdan o'tish mumkin."

#: apps/bot/handlers.py:119
msgid "You are already registered."
msgstr "Siz allaqachon ro'yxatdan o'tgansiz."

#: apps/bot/handlers.py:124
#, python-format
msgid ""
"The number %(phone)s is not in the company list. Ask the dispatcher to add "
"you, then send it again with /start."
msgstr "%(phone)s raqami kompaniya ro'yxatida yo'q. Dispetcherdan sizni qo'shishini so'rang, keyin /start orqali qayta yuboring."

#: apps/bot/handlers.py:128
msgid ""
"Thank you! A manager will confirm your registration soon. I will write to "
"you here."
msgstr "Rahmat! Rahbar tez orada ro'yxatdan o'tishingizni tasdiqlaydi. Shu yerda sizga yozaman."

#: apps/bot/handlers.py:140
msgid "This sign-in link has expired. Start again on the website."
msgstr "Bu kirish havolasining muddati tugagan. Saytda qaytadan boshlang."

#: apps/bot/handlers.py:141
msgid ""
"You are not registered yet. Send /start and share your phone number first."
msgstr "Siz hali ro'yxatdan o'tmagansiz. Avval /start yuboring va telefon raqamingizni ulashing."

#: apps/bot/handlers.py:143
msgid "Your account cannot use the web app. Drivers work in this bot only."
msgstr "Hisobingiz veb-ilovadan foydalana olmaydi. Haydovchilar faqat shu botda ishlaydi."

#: apps/bot/handlers.py:144
msgid "Wrong number. The sign-in was cancelled. Start again on the website."
msgstr "Noto'g'ri raqam. Kirish bekor qilindi. Saytda qaytadan boshlang."

#: apps/bot/handlers.py:146
msgid ""
"The sign-in was cancelled. If you did not try to sign in, tell the director."
msgstr "Kirish bekor qilindi. Agar siz kirmoqchi bo'lmagan bo'lsangiz, direktorga xabar bering."

#: apps/bot/handlers.py:158
msgid "Sign in to the Aktiv Fleet web app?"
msgstr "Aktiv Fleet veb-ilovasiga kirasizmi?"

#: apps/bot/handlers.py:160
#, python-format
msgid "Browser: %(browser)s"
msgstr "Brauzer: %(browser)s"

#: apps/bot/handlers.py:161
msgid "Tap the number shown on your screen."
msgstr "Ekraningizda ko'rsatilgan raqamni bosing."

#: apps/bot/handlers.py:174
msgid "You are signed in. You can go back to the browser."
msgstr "Siz tizimga kirdingiz. Brauzerga qaytishingiz mumkin."

#: apps/bot/handlers.py:182
msgid "I don't understand this yet. Send /help to see what I can do."
msgstr "Buni hali tushunmayman. Nimalar qila olishimni ko'rish uchun /help yuboring."

