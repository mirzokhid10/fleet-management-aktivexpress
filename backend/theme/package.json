{
  "name": "fleet-theme",
  "private": true,
  "description": "Builds static/css/app.css from the TailAdmin theme + Django templates, and copies Alpine.js into static/vendor.",
  "scripts": {
    "vendor": "mkdir -p ../static/vendor && cp node_modules/alpinejs/dist/cdn.min.js ../static/vendor/alpine.min.js && cp node_modules/@alpinejs/persist/dist/cdn.min.js ../static/vendor/alpine-persist.min.js && cp node_modules/@alpinejs/collapse/dist/cdn.min.js ../static/vendor/alpine-collapse.min.js",
    "build": "npm run vendor && tailwindcss -i src/app.css -o ../static/css/app.css --minify",
    "watch": "npm run vendor && tailwindcss -i src/app.css -o ../static/css/app.css --watch=always"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.17",
    "@tailwindcss/forms": "0.5.10",
    "tailwindcss": "4.1.17",
    "tw-animate-css": "1.4.0"
  },
  "dependencies": {
    "@alpinejs/collapse": "3.15.2",
    "@alpinejs/persist": "3.15.2",
    "alpinejs": "3.15.2"
  }
}
